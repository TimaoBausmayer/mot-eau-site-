{
  "rules": {
    "moteau": {
      ".read": "auth != null && auth.token.email == 'timaobausmayer04@gmail.com'",
      ".write": "auth != null && auth.token.email == 'timaobausmayer04@gmail.com'",
      "adminCustomCSS": {
        ".read": true
      },
      "adminCustomHTML": {
        ".read": true
      },
      "passwords": {},
      "clubCodeHash": {
        ".read": true
      },
      "memberNames": {
        ".read": true
      },
      "equipmentOut": {
        ".read": true
      },
      "hero": {
        ".read": true
      },
      "contact": {
        ".read": true
      },
      "branding": {
        ".read": true
      },
      "sponsors": {
        ".read": true
      },
      "products": {
        ".read": true,
        "$i": {
          "qty": {
            ".write": "data.exists() && newData.isNumber() && newData.val() >= 0 && newData.val() < data.val()"
          },
          "stock": {
            ".write": "newData.val() == 'stock_rupture'"
          }
        }
      },
      "planning": {
        ".read": true,
        "$row": {
          "participants": {
            "$p": {
              ".write": "!data.exists() && newData.exists()",
              ".validate": "newData.hasChildren(['name','email'])"
            }
          }
        }
      },
      "planningTypes": {
        ".read": true
      },
      "resultsDisplay": {
        ".read": true
      },
      "competitions": {
        ".read": true
      },
      "rules": {
        ".read": true
      },
      "ruleDocs": {
        ".read": true
      },
      "history": {
        ".read": true
      },
      "tutorials": {
        ".read": true
      },
      "gallery": {
        ".read": true
      },
      "donations": {
        ".read": true
      },
      "freeDonationLink": {
        ".read": true
      },
      "membership": {
        ".read": true
      },
      "memberships": {
        "$id": {
          ".write": "!data.exists() && newData.exists()",
          ".validate": "newData.hasChildren()"
        }
      },
      "registrations": {
        "$id": {
          ".write": "!data.exists() && newData.exists()",
          ".validate": "newData.hasChildren()"
        }
      },
      "competitionFee": {
        ".read": true
      },
      "membershipDiscount": {
        ".read": true
      },
      "referralGifts": {
        ".read": true
      },
      "referralRewards": {},
      "notifications": {
        "$id": {
          ".write": "!data.exists() && newData.exists()",
          ".validate": "newData.hasChildren()"
        }
      },
      "waiverText": {
        ".read": true
      },
      "waivers": {
        "$id": {
          ".write": "!data.exists() && newData.exists()",
          ".validate": "newData.hasChildren()"
        }
      },
      "reviews": {
        ".read": true,
        "$id": {
          ".write": "auth != null && $id == auth.uid && !data.exists() && newData.child('uid').val() == auth.uid && (newData.child('verified').val() != true || root.child('moteau/userRecords/' + auth.uid).exists())",
          ".validate": "newData.hasChildren(['name','rating','comment'])",
          "rating": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5"
          },
          "comment": {
            ".validate": "newData.isString() && newData.val().length <= 1500"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "reply": {
            ".validate": "auth != null && auth.token.email == 'timaobausmayer04@gmail.com'"
          },
          "ts": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          }
        }
      },
      "visitCount": {
        ".read": true,
        ".write": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1"
      },
      "clubMessages": {
        ".read": true,
        "$id": {
          ".write": "!data.exists() && newData.exists()",
          ".validate": "newData.hasChildren()"
        }
      },
      "clubPosts": {
        ".read": true
      },
      "giftCards": {},
      "giftCardOptions": {
        ".read": true
      },
      "giftCardCustomLink": {
        ".read": true
      },
      "equipment": {
        ".read": true
      },
      "equipmentLoans": {
        "$id": {
          ".write": "!data.exists() && newData.exists()",
          ".validate": "newData.hasChildren()"
        }
      },
      "liveInsta": {
        ".read": true
      },
      "donationRecords": {
        "$id": {
          ".write": "!data.exists() && newData.exists()",
          ".validate": "newData.hasChildren()"
        }
      },
      "orders": {
        "$id": {
          ".write": "!data.exists() && newData.exists()",
          ".validate": "newData.hasChildren()"
        }
      },
      "promoCodes": {
        ".read": true,
        "$i": {
          "usedCount": {
            ".write": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1"
          }
        }
      },
      "announcements": {
        ".read": true
      },
      "memberHashes": {
        "$h": {
          ".read": true
        }
      },
      "giftCardsByCode": {
        "$code": {
          ".read": true,
          ".write": "!data.exists() && newData.child('pending').val() == true && newData.child('code').val() == $code && newData.child('remaining').val() == newData.child('amount').val()",
          "remaining": {
            ".write": "data.exists() && data.parent().child('pending').val() != true && newData.isNumber() && newData.val() >= 0 && newData.val() < data.val()"
          },
          "redeemed": {
            ".write": "data.parent().child('pending').val() != true && newData.val() == true"
          }
        }
      },
      "userRecords": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          "$ref": {
            ".write": "auth != null && auth.uid == $uid && !data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['ref','coll'])"
          }
        }
      },
      "userProfiles": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && auth.uid == $uid"
        }
      },
      "visitsByDay": {
        "$day": {
          ".write": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1",
          ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
        }
      },
      "sectionViews": {
        "$sec": {
          ".write": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1",
          ".validate": "$sec.matches(/^[a-z]{1,20}$/)"
        }
      },
      "visitSources": {
        "$src": {
          ".write": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1",
          ".validate": "$src.matches(/^[a-zA-Z0-9_-]{1,60}$/)"
        }
      },
      "visitDevices": {
        "$dev": {
          ".write": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1",
          ".validate": "$dev == 'mobile' || $dev == 'tablette' || $dev == 'ordinateur'"
        }
      },
      "googleReviewLink": {
        ".read": true
      },
      "productPolls": {
        ".read": true,
        "$pid": {
          ".validate": "$pid.matches(/^[a-zA-Z0-9_-]{1,40}$/)",
          "$voter": {
            ".write": "!data.exists() && newData.exists() && (($voter.matches(/^v[0-9a-f]{24}$/)) || (auth != null && $voter == auth.uid))",
            ".validate": "newData.hasChildren(['r'])",
            "r": {
              ".validate": "newData.val() == 'love' || newData.val() == 'like' || newData.val() == 'meh' || newData.val() == 'no'"
            },
            "buy": {
              ".validate": "newData.isBoolean()"
            },
            "ts": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "founders": {
        ".read": true
      },
      "pushSubs": {
        "$k": {
          ".write": "newData.exists() && (!data.exists() || data.child('endpoint').val() == newData.child('endpoint').val())",
          ".validate": "$k.matches(/^[0-9a-f]{32}$/) && newData.hasChildren(['endpoint','keys']) && newData.child('endpoint').isString() && newData.child('endpoint').val().beginsWith('https://') && newData.child('endpoint').val().length < 1000",
          "keys": {
            ".validate": "newData.hasChildren(['p256dh','auth'])"
          }
        }
      },
      "team": {
        ".read": true
      },
      "news": {
        ".read": true
      },
      "countdown": {
        ".read": true
      },
      "contests": {
        ".read": true
      },
      "loyaltyConfig": {
        ".read": true
      },
      "runs": {
        ".read": true
      },
      "pilotProfiles": {
        ".read": true
      },
      "i18nEn": {
        ".read": true
      },
      "faq": {
        ".read": true,
        "$qid": {
          ".write": "auth != null && ((!data.exists() && newData.child('uid').val() == auth.uid) || (data.exists() && !newData.exists() && data.child('uid').val() == auth.uid))",
          ".validate": "newData.hasChildren(['q','name','uid','ts'])",
          "q": {
            ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 600"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "uid": {
            ".validate": "newData.isString()"
          },
          "ts": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "admin": {
            ".validate": "newData.isBoolean() && newData.val() == true && auth.token.email == 'timaobausmayer04@gmail.com'"
          },
          "pinned": {
            ".validate": "newData.isBoolean() && auth.token.email == 'timaobausmayer04@gmail.com'"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "faqAnswers": {
        ".read": true,
        "$qid": {
          "$aid": {
            ".write": "auth != null && ((!data.exists() && newData.child('uid').val() == auth.uid && root.child('moteau/faq/' + $qid).exists()) || (data.exists() && !newData.exists() && data.child('uid').val() == auth.uid))",
            ".validate": "newData.hasChildren(['text','name','uid','ts'])",
            "text": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 1500"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "uid": {
              ".validate": "newData.isString()"
            },
            "ts": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "admin": {
              ".validate": "newData.isBoolean() && newData.val() == true && auth.token.email == 'timaobausmayer04@gmail.com'"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "contestVotes": {
        "$cid": {
          ".read": true,
          "$voter": {
            ".write": "!data.exists() && newData.exists() && root.child('moteau/contests/' + $cid + '/open').val() == true && root.child('moteau/contests/' + $cid + '/options/' + newData.child('opt').val()).exists() && (root.child('moteau/contests/' + $cid + '/needAccount').val() == false ? ($voter.matches(/^v[0-9a-f]{24}$/) || (auth != null && $voter == auth.uid)) : (auth != null && $voter == auth.uid))",
            ".validate": "newData.hasChildren(['opt'])",
            "opt": {
              ".validate": "newData.isString()"
            },
            "ts": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "loyalty": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          "requests": {
            "$rid": {
              ".write": "auth != null && auth.uid == $uid && !data.exists() && newData.child('status').val() == 'pending'",
              ".validate": "$rid.matches(/^[a-zA-Z0-9]{1,30}$/) && newData.hasChildren(['rewardId','label','points','status','ts'])",
              "points": {
                ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 1000000"
              },
              "label": {
                ".validate": "newData.isString() && newData.val().length <= 120"
              },
              "rewardId": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "name": {
                ".validate": "newData.isString() && newData.val().length <= 80"
              },
              "email": {
                ".validate": "newData.isString() && newData.val().length <= 120"
              },
              "rid": {
                ".validate": "newData.isString()"
              },
              "ts": {
                ".validate": "newData.isNumber() && newData.val() <= now"
              },
              "status": {
                ".validate": "newData.isString()"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        }
      },
      "productCosts": {},
      "expenses": {}
    }
  }
}